# Files NOT uploaded to Cloud Build by `gcloud builds submit`.
# data/ is excluded here and fetched from the project bucket inside the build
# (cloudbuild.yaml), so deploys work from any computer that has the code.
# .dockerignore (used inside the build) keeps data/ so it lands in the image.
data/
.git/
.gitignore
.gcloudignore
.dockerignore
.runtime/
.env
.env.*
!.env.example
__pycache__/
**/__pycache__/
*.pyc
*.log
tmp/
work/
tests/
AUDIT_REPORT.md
*.pdf
개론서 파일/
data/tmp*/
data/*.png
data/text/**/*.ocr.json
node_modules/
