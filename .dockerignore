# Files NOT uploaded to Cloud Build / the container image.
# Note: data/ is intentionally included (unlike .gitignore) because the
# server reads library.sqlite3, the E5 model and page text from it.
.git/
.gitignore
.gcloudignore
.dockerignore
.runtime/
.env
.env.*
!.env.example
__pycache__/
**/__pycache__/
*.pyc
*.log
tmp/
work/
tests/
AUDIT_REPORT.md
*.pdf
개론서 파일/
data/tmp*/
data/*.png
data/text/**/*.ocr.json
# The full-precision BGE-M3 model only builds the index; queries use model_quantized.onnx.
data/models/bge-m3/model.onnx
data/models/bge-m3/model.onnx_data
data/models/**/*.download
node_modules/
